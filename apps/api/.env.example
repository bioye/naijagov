# NaijaGov API — Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────
# Neon pooled connection string (use pooled, not direct, for serverless)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/naijagov?sslmode=require

# ── Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=your-secret-here-must-be-at-least-32-characters-long

# ── SMS (Termii) ──────────────────────────────────────────────
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=NaijaGov

# ── Server ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
